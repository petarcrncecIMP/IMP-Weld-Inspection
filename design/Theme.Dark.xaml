<!--
  IMP Weld Photos - dark theme.
  Values taken from Kosovnice dark mode (IMP_Kosovnice/src/App.css). Same keys as
  Theme.Light.xaml. The header stays the accent colour in both themes.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Accent: Zvari green -->
    <Color x:Key="AccentColor">#2E7D32</Color>
    <Color x:Key="AccentHoverColor">#256B29</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentTintBrush" Color="#262E7D32" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#242424" />
    <SolidColorBrush x:Key="ToolbarButtonBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#80000000" />

    <!-- Text and lines -->
    <SolidColorBrush x:Key="TextBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="TextStrongBrush" Color="#D0D0D0" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3A3A" />

    <!-- Table (Kosovnice grid, dark) -->
    <SolidColorBrush x:Key="TableHeaderBrush" Color="#252525" />
    <SolidColorBrush x:Key="TableRowBrush" Color="#252525" />
    <SolidColorBrush x:Key="TableAltRowBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="TableRowSeparatorBrush" Color="#2A2A2A" />

    <!-- Status -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="SuccessTintBrush" Color="#2622C55E" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="WarningTintBrush" Color="#26FBBF24" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="DangerTintBrush" Color="#26F87171" />
    <SolidColorBrush x:Key="NeutralTintBrush" Color="#269CA3AF" />

    <!-- Typography. Bundle BarlowCondensed-Bold.ttf under Assets/Fonts (see DESIGN.md §3). -->
    <FontFamily x:Key="HeadingFont">pack://application:,,,/Assets/Fonts/#Barlow Condensed, Segoe UI</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI</FontFamily>
    <sys:Double x:Key="HeadingFontSize">22</sys:Double>
    <sys:Double x:Key="BodyFontSize">13</sys:Double>
    <sys:Double x:Key="SmallFontSize">12</sys:Double>
    <sys:Double x:Key="TinyFontSize">11</sys:Double>

    <!-- Shape -->
    <CornerRadius x:Key="ButtonRadius">6</CornerRadius>
    <CornerRadius x:Key="ToolbarButtonRadius">7</CornerRadius>
    <CornerRadius x:Key="DialogRadius">12</CornerRadius>
    <CornerRadius x:Key="ChipRadius">4</CornerRadius>
    <sys:Double x:Key="ToolbarButtonSize">34</sys:Double>
    <sys:Double x:Key="HeaderHeight">52</sys:Double>
    <sys:Double x:Key="TableRowHeight">28</sys:Double>
    <sys:Double x:Key="TableHeaderHeight">32</sys:Double>

    <!-- Shadows -->
    <DropShadowEffect x:Key="HeaderShadow" Direction="270" ShadowDepth="2" BlurRadius="6" Opacity="0.5" Color="Black" />
    <DropShadowEffect x:Key="DialogShadow" Direction="270" ShadowDepth="18" BlurRadius="48" Opacity="0.5" Color="Black" />
</ResourceDictionary>
