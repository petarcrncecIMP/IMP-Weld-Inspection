<!--
  IMP Weld Inspection - light theme.
  Values taken from Kosovnice (IMP_Kosovnice/src/App.css). Same keys as
  Theme.Dark.xaml, so switching theme is swapping this dictionary.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Accent: Zvari green -->
    <Color x:Key="AccentColor">#2E7D32</Color>
    <Color x:Key="AccentHoverColor">#256B29</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentTintBrush" Color="#172E7D32" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#E8E8E8" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToolbarButtonBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#66000000" />

    <!-- Text and lines -->
    <SolidColorBrush x:Key="TextBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="TextStrongBrush" Color="#111827" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D1D5DB" />

    <!-- Table (Kosovnice grid) -->
    <SolidColorBrush x:Key="TableHeaderBrush" Color="#E8E8E8" />
    <SolidColorBrush x:Key="TableRowBrush" Color="#F8F8F8" />
    <SolidColorBrush x:Key="TableAltRowBrush" Color="#F8F8F8" />
    <SolidColorBrush x:Key="TableRowSeparatorBrush" Color="#FFFFFF" />

    <!-- Status -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="#15803D" />
    <SolidColorBrush x:Key="SuccessTintBrush" Color="#1F16A34A" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />
    <SolidColorBrush x:Key="WarningTintBrush" Color="#1FD97706" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="DangerTintBrush" Color="#1FDC2626" />
    <SolidColorBrush x:Key="NeutralTintBrush" Color="#1F6B7280" />

    <!-- Typography. Bundle BarlowCondensed-Bold.ttf under Assets/Fonts (see DESIGN.md §3). -->
    <FontFamily x:Key="HeadingFont">pack://application:,,,/Assets/Fonts/#Barlow Condensed, Segoe UI</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI</FontFamily>
    <sys:Double x:Key="HeadingFontSize">22</sys:Double>
    <sys:Double x:Key="BodyFontSize">13</sys:Double>
    <sys:Double x:Key="SmallFontSize">12</sys:Double>
    <sys:Double x:Key="TinyFontSize">11</sys:Double>

    <!-- Shape -->
    <CornerRadius x:Key="ButtonRadius">6</CornerRadius>
    <CornerRadius x:Key="ToolbarButtonRadius">7</CornerRadius>
    <CornerRadius x:Key="DialogRadius">12</CornerRadius>
    <CornerRadius x:Key="ChipRadius">4</CornerRadius>
    <sys:Double x:Key="ToolbarButtonSize">34</sys:Double>
    <sys:Double x:Key="HeaderHeight">52</sys:Double>
    <sys:Double x:Key="TableRowHeight">28</sys:Double>
    <sys:Double x:Key="TableHeaderHeight">32</sys:Double>

    <!-- Shadows -->
    <DropShadowEffect x:Key="HeaderShadow" Direction="270" ShadowDepth="2" BlurRadius="6" Opacity="0.25" Color="Black" />
    <DropShadowEffect x:Key="DialogShadow" Direction="270" ShadowDepth="18" BlurRadius="48" Opacity="0.35" Color="Black" />
</ResourceDictionary>
