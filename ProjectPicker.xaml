<!--
  Project picker for Pregled: a copy of Kosovnice's typeable combobox (Combobox.tsx).
  Closed it shows the selected project; focused it shows what you type and lists matches.
-->
<UserControl x:Class="IMPWeldPhotos.ProjectPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <TextBox x:Name="Input" Style="{StaticResource ComboInput}" Tag="— izberite projekt —"
                 AutomationProperties.Name="Projekt" AutomationProperties.AutomationId="ProjectInput"
                 GotKeyboardFocus="OnInputFocused" PreviewMouseLeftButtonDown="OnInputMouseDown"
                 TextChanged="OnInputTextChanged" PreviewKeyDown="OnInputKeyDown" />

        <!-- .combo-listbox: surface, 1 px border, radius 7, padding 4, max 340 px, soft shadow.
             The margin leaves room for the shadow inside the popup. -->
        <Popup x:Name="Dropdown" PlacementTarget="{Binding ElementName=Input}" Placement="Bottom"
               HorizontalOffset="-12" VerticalOffset="-10" AllowsTransparency="True" PopupAnimation="None" StaysOpen="True">
            <Border Margin="12,12,12,16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="7" Padding="4" MinWidth="340"
                    Width="{Binding ActualWidth, ElementName=Input}">
                <Border.Effect>
                    <DropShadowEffect Direction="270" ShadowDepth="6" BlurRadius="20" Opacity="0.2" Color="Black" />
                </Border.Effect>
                <Grid>
                    <TextBlock x:Name="NoMatch" Text="Ni zadetkov" Margin="10,8" Foreground="{DynamicResource TextMutedBrush}"
                               Visibility="Collapsed" />
                    <ListBox x:Name="Options" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource ComboOption}"
                             MaxHeight="340" Focusable="False" AutomationProperties.AutomationId="ProjectOptions"
                             PreviewMouseMove="OnOptionsMouseMove" PreviewMouseLeftButtonDown="OnOptionsMouseDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel ToolTip="{Binding FolderName}">
                                    <TextBlock x:Name="Code" Text="{Binding Code}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="13" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextBrush}" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Code}" Value="">
                                        <Setter TargetName="Code" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="Name" Property="FontWeight" Value="Bold" />
                                        <Setter TargetName="Code" Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
