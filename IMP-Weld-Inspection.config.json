{
  // Optional. Everything here has a built-in default; keep only what you change.

  // Where photos go, and the isometrija tree whose titles.json is the offline fallback.
  "DestinationRoot": "U:\\100_Identi\\140_Zvari",
  "IsoRoot": "U:\\100_Identi\\130_Izometrije",

  // CommonData: project, unit and isometrija names come from the database for the
  // signed-in user (roles Fab.Odata / Fab.Read). The built-in connection is production
  // CommonData with the AutoCAD tools' app registration; set BaseUrl, TenantId, ClientId
  // or Scope here to use another one. "Enabled": false uses titles.json only.
  "Api": {
    "Enabled": true
  },

  // Fallback drive poll, in seconds, beside the WMI volume-arrival event.
  "PollSeconds": 3
}
