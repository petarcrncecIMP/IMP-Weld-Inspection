<Project>
  <PropertyGroup>
    <AssemblyName>IMP-Weld-Inspection</AssemblyName>
    <IntermediateOutputPath>obj\Debug\</IntermediateOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>C:\VS_Projects\IMPWeldPhotos\obj\</MSBuildProjectExtensionsPath>
    <_TargetAssemblyProjectName>IMPWeldPhotos</_TargetAssemblyProjectName>
    <RootNamespace>IMPWeldPhotos</RootNamespace>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <!-- Desktop app: watches for an SD card, copies endoscope weld photos into
       U:\100_Identi\140_Zvari and stamps each with its own name. See SPEC.md and
       design/DESIGN.md. `dotnet publish -c Release` gives one self-contained
       IMP-Weld-Inspection.exe. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IMPWeldPhotos</RootNamespace>
    <!-- The exe: IMP-Weld-Inspection.exe. Hyphens, not spaces: GitHub turns spaces in release
         asset names into dots, and the Kosovnice apps menu links to this exact name.
         Window title and Product keep the spaces. Namespace and project keep the old name. -->
    <Product>IMP Weld Inspection</Product>
    <Company>IMP Promont</Company>
    <!-- 0.0.0 marks a local build, which never offers updates. Releases get the tag's
         version (release.yml passes -p:Version). -->
    <Version>0.0.0</Version>
    <ApplicationIcon>design\icon\IMPWeldPhotos.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Roughly halves the download; costs a moment at start-up. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- The WPF SDK leaves these out of the implicit usings. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MetadataExtractor" Version="2.8.1" />
    <!-- Same MSAL line the CommonData Client package pins for net10. -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.73.1" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
  <!-- design/ is the source of truth for the look (design/DESIGN.md). Its files are
       linked in rather than copied, so make_assets.py output flows straight through. -->
  <ItemGroup>
    <None Remove="design\**" />
    <None Include="Assets\Fonts\OFL.txt" />
  </ItemGroup>
  <ItemGroup>
    <None Update="IMP-Weld-Inspection.config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>
